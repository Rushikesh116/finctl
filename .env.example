# FinCtl configuration. Copy to .env and edit. .env is gitignored; never commit it.
# Every environment variable the app reads is listed here, with its default.

# --- Determinism and demo ----------------------------------------------------
# 1 = serve a pre-computed run from committed fixtures. No network, no API key, no
# cold-start cost, identical output on every click. This is what the deployed
# environment runs, deliberately — see README.
DEMO_MODE=1

# Master seed for anything stochastic outside dataset generation. Dataset seeds are
# baked into the dataset names (dev_seed_11, holdout_seed_97) and are not settable.
FINCTL_SEED=11

# --- Anthropic (Layer 4 adjudication only; unused when DEMO_MODE=1) ----------
# Leave empty to force fixture-only operation: a cache miss then fails loudly
# instead of silently reaching the network.
ANTHROPIC_API_KEY=
FINCTL_LLM_MODEL=claude-opus-5
# Hard ceiling on LLM calls per run. Exceeding it aborts the run; it does not degrade
# quietly. Layers 1-3 should leave under 5% of the batch for the LLM.
FINCTL_LLM_CALL_BUDGET=25
FINCTL_LLM_MAX_RETRIES=2
# Recorded responses, keyed by a hash of the prompt, so a run replays with no network.
FINCTL_LLM_FIXTURE_DIR=fixtures/llm

# --- Cost accounting ---------------------------------------------------------
# USD per million tokens for FINCTL_LLM_MODEL. Verified 2026-08-26 from
# https://platform.claude.com/docs/en/about-claude/models/overview.md
FINCTL_USD_PER_MTOK_IN=5.00
FINCTL_USD_PER_MTOK_OUT=25.00
# Cache reads bill at 10% of the input rate (same source).
FINCTL_CACHE_READ_MULTIPLIER=0.10
# The metrics block reports cost per 1000 records in rupees, which needs an FX rate.
# Left empty on purpose: an unset rate makes the harness print USD and mark the INR
# figure TBD, rather than a plausible-looking wrong number. See docs/OPEN_QUESTIONS.md Q-004.
FINCTL_USD_INR=

# --- Layer 2: bounded settlement subset search -------------------------------
# The bounded search IS the stopping rule. On overflow the batch becomes a typed
# exception; it is never silently dropped and never runs unbounded.
FINCTL_SUBSET_NODE_BUDGET=200000
FINCTL_SUBSET_TIMEOUT_MS=2000

# --- Layer 3: fuzzy matching and the ambiguity rule --------------------------
# Amount tolerance in paise and settlement date window in days for candidate generation.
FINCTL_AMOUNT_TOLERANCE_PAISE=0
FINCTL_DATE_WINDOW_DAYS=7
# Refuse to match when best and second-best candidate scores fall within this margin.
# This is what makes pathology 7 an AMBIGUOUS exception instead of a coin flip.
FINCTL_AMBIGUITY_MARGIN=0.05

# --- Storage -----------------------------------------------------------------
FINCTL_DB_PATH=finctl.db
